# --- Telegram (from @BotFather + @userinfobot) ---
TELEGRAM_BOT_TOKEN=your_token_here
# The capture channel's chat id. Must be negative and start with -100.
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional but recommended: set the same value here and pass it as secret_token
# when calling setWebhook, so /api/webhook can reject calls that don't come from Telegram.
TELEGRAM_WEBHOOK_SECRET=choose_a_random_string

# --- Gemini (from Google AI Studio) — used for scoring + keyword extraction ---
GEMINI_API_KEY=your_gemini_key_here

# --- Claude (from console.anthropic.com) — used for drafting from B1 onward ---
ANTHROPIC_API_KEY=your_anthropic_key_here

# Which model drafts the post. "claude" (default, B1 onward) or "gemini" (L3 demo only).
DRAFT_MODEL=claude

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Below this score (0-10), a note is rejected before drafting.
SCORE_THRESHOLD=6
